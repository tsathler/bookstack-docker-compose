# ==============================================================================
# BOOKSTACK - ARQUIVO DE CONFIGURAÇÃO DE AMBIENTE (.env)
# ==============================================================================
# Copie este arquivo para '.env' e configure as variáveis conforme seu ambiente:
#   cp .env.example .env
#
# ATENÇÃO: NUNCA submeta o arquivo '.env' com senhas reais para repositórios Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AMBIENTE E PERFORMANCE DO CONTAINER (LinuxServer)
# ------------------------------------------------------------------------------
# PUID e PGID: IDs do usuário e grupo no host Linux para evitar problemas de
# permissão nos volumes mapeados. (Descubra rodando `id $USER` no terminal host).
PUID=1000
PGID=1000

# Fuso horário corporativo
TZ=America/Sao_Paulo

# Imagem da aplicação. Use uma tag/revisão aprovada pela sua política de
# mudanças; não use 'latest' em produção sem validar e registrar o upgrade.
BOOKSTACK_IMAGE=lscr.io/linuxserver/bookstack:latest
UMASK=027

# URL base pública da aplicação (DEVE incluir protocolo https:// e sem barra final)
# IMPORTANTE: Esta URL é utilizada para gerar links de e-mail e assets.
APP_URL=https://docs.empresa.com.br

# ------------------------------------------------------------------------------
# 2. BANCO DE DADOS (MariaDB 10.11)
# ------------------------------------------------------------------------------
# Host do banco no Docker Compose (nome do serviço) e porta interna padrão
DB_HOST=bookstack_db
DB_PORT=3306

# Nome do banco de dados a ser criado e utilizado pelo BookStack
DB_DATABASE=bookstackapp

# Usuário de aplicação do banco de dados
DB_USER=bookstack_user

# Senha segura do usuário de aplicação do banco de dados (Gere uma senha forte!)
DB_PASS=SuaSenhaForteBookStack_App_2026!#

# Senha do usuário 'root' do MariaDB (Essencial para manutenção e backup)
MYSQL_ROOT_PASSWORD=SuaSenhaRootUltraSegura_DB_2026!#

# ------------------------------------------------------------------------------
# 3. UPLOADS E LIMITES DE ARQUIVO
# ------------------------------------------------------------------------------
# Limite máximo de upload em Megabytes (anexos de PDFs, ISOs, logs de auditoria).
# Este valor deve estar sincronizado com o NGINX (client_max_body_size) e PHP.
FILE_UPLOAD_LIMIT=100

# ------------------------------------------------------------------------------
# 4. AUTENTICAÇÃO HÍBRIDA / ACTIVE DIRECTORY & OPENLDAP (SSO)
# ------------------------------------------------------------------------------
# Método de autenticação principal: 'ldap' ou 'standard' (local).
# Ao definir 'ldap', o BookStack mantém suporte à CONTA LOCAL DE EMERGÊNCIA
# (break-glass account) permitindo login direto via e-mail e senha local.
AUTH_METHOD=ldap

# Servidor LDAP corporativo (Recomendado LDAPS seguro na porta 636)
# Exemplo LDAPS: ldaps://dc01.empresa.local:636
# Exemplo LDAP:  ldap://dc01.empresa.local:389
LDAP_SERVER=ldaps://dc01.empresa.local:636

# Base DN onde os usuários e grupos da organização estão localizados
LDAP_BASE_DN=DC=empresa,DC=local

# Conta de Serviço (Service Account) com permissão de leitura no Active Directory
# Formato DN completo:
LDAP_DN=CN=svc_bookstack,OU=ServiceAccounts,OU=TI,DC=empresa,DC=local

# Senha da Conta de Serviço no Active Directory
LDAP_PASS=SenhaDoServiceAccount_AD_2026!#

# Filtro de busca do usuário (Filtra por contas de usuário ativas via sAMAccountName)
LDAP_USER_FILTER=(&(objectCategory=Person)(sAMAccountName=$${user}))

# Versão do protocolo LDAP (Padrão: 3)
LDAP_VERSION=3

# Atributo identificador único no AD (sAMAccountName, userPrincipalName ou objectGUID)
LDAP_ID_ATTRIBUTE=sAMAccountName

# Atributo de e-mail do usuário no AD
LDAP_EMAIL_ATTRIBUTE=mail

# Atributo de nome de exibição no AD
LDAP_DISPLAY_NAME_ATTRIBUTE=displayName

# Sincronização automática de grupos do AD para Roles no BookStack
LDAP_USER_TO_GROUPS=true

# Atributo do AD que lista os grupos aos quais o usuário pertence
LDAP_GROUP_ATTRIBUTE=memberOf

# Se 'true', remove o usuário de roles no BookStack se ele for removido do grupo no AD
LDAP_REMOVE_FROM_GROUPS=false

# Ignorar validação de certificado TLS/SSL caso a CA corporativa seja interna/autoassinada
# ATENÇÃO: Use 'false' em produção com CA configurada no host; use 'true' se houver erro de TLS handshake.
LDAP_TLS_INSECURE=false

# ------------------------------------------------------------------------------
# 5. SERVIÇO DE E-MAIL / NOTIFICAÇÕES SMTP
# ------------------------------------------------------------------------------
# Driver de e-mail (smtp)
MAIL_MAILER=smtp

# Host do Servidor SMTP Corporativo (ex: Microsoft 365, Google Workspace, Postfix)
MAIL_HOST=smtp.empresa.com.br

# Porta do Servidor SMTP (587 para STARTTLS, 465 para SSL, 25 para Relay interno sem auth)
MAIL_PORT=587

# Usuário de autenticação SMTP
MAIL_USERNAME=notificacoes-ti@empresa.com.br

# Senha de autenticação SMTP
MAIL_PASSWORD=SenhaSeguraSmtp2026!#

# Tipo de criptografia: 'tls' (porta 587), 'ssl' (porta 465) ou 'null' (sem criptografia)
MAIL_ENCRYPTION=tls

# Endereço 'From' que aparecerá como remetente
MAIL_FROM=notificacoes-ti@empresa.com.br

# Nome amigável do remetente
MAIL_FROM_NAME="BookStack - Central de Documentação TI"

# ------------------------------------------------------------------------------
# 6. CONFIGURAÇÃO DE BACKUP AUTOMATIZADO
# ------------------------------------------------------------------------------
# Diretório destino de armazenamento de backups no host
BACKUP_DIR=/var/backups/bookstack

# Dias de retenção dos arquivos de backup antes da rotação automática
BACKUP_RETENTION_DAYS=15

# ------------------------------------------------------------------------------
# 7. ASSISTENTE DE IA (NVIDIA NIM)
# ------------------------------------------------------------------------------
# O serviço faz apenas conexões de saída HTTPS para o endpoint NIM.
AI_ENABLED=false
AI_BASE_URL=https://integrate.api.nvidia.com/v1
# Informe o identificador exato do modelo aprovado no catálogo NVIDIA.
AI_MODEL=COLOQUE_O_MODELO_NIM_AQUI
NVIDIA_API_KEY=

# Token do usuário técnico de leitura criado no BookStack.
BOOKSTACK_API_TOKEN_ID=
BOOKSTACK_API_TOKEN_SECRET=

# Token de acesso do endpoint interno do chatbot; gere um valor aleatório forte.
CHATBOT_ACCESS_TOKEN=
CHATBOT_BIND_PORT=8000
